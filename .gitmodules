[submodule "Renderer/Lib/SDL"]
	path = renderer/lib/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "Renderer/Lib/volk"]
	path = renderer/lib/volk
	url = https://github.com/zeux/volk.git
[submodule "Renderer/Lib/VulkanMemoryAllocator"]
	path = renderer/lib/VulkanMemoryAllocator
	url = https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
[submodule "Renderer/Lib/cgltf"]
	path = renderer/lib/cgltf
	url = https://github.com/jkuhlmann/cgltf.git
[submodule "Renderer/Lib/KTX-Software"]
	path = renderer/lib/KTX-Software
	url = https://github.com/KhronosGroup/KTX-Software.git
[submodule "Renderer/Lib/imgui"]
	path = renderer/lib/imgui
	url = https://github.com/ocornut/imgui.git
[submodule "Renderer/Lib/meshoptimizer"]
	path = renderer/lib/meshoptimizer
	url = https://github.com/zeux/meshoptimizer.git
[submodule "Renderer/Lib/SPIRV-Cross"]
	path = renderer/lib/SPIRV-Cross
	url = https://github.com/KhronosGroup/SPIRV-Cross.git
[submodule "renderer/lib/EASTL"]
	path = renderer/lib/EASTL
	url = https://github.com/electronicarts/EASTL.git
